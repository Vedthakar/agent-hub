# Every secret lives here (or in your host's env), never in code. Copy to .env and fill in.

# ---------- Hub ----------
PORT=8787
HUB_PUBLIC_URL=https://hub.example.com        # must be https for Claude/ChatGPT/Gemini connectors
HUB_OWNER_NAME=Ved
HUB_OWNER_PASSWORD=                           # dashboard + OAuth consent screen (required in production)
HUB_SESSION_SECRET=                           # random 32+ chars; signs dashboard cookies
HUB_TIMEZONE=America/New_York
LOG_LEVEL=info                                # debug | info | warn | error (message bodies are always redacted)

# Postgres (e.g. Supabase: Project Settings → Database → connection string). Omit to use embedded PGlite in .data/
DATABASE_URL=

# ---------- Router LLM ----------
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# ROUTER_PROVIDER=anthropic                   # anthropic | openai
# ROUTER_MODEL=claude-sonnet-4-5
ROUTER_DEBOUNCE_MS=600000                     # 10 min of quiet ends a conversation burst
ROUTER_MAX_HOPS=2
# ROUTER_TIMEOUT_MS=60000                     # per LLM call
# ROUTER_MAX_ATTEMPTS=5                       # then the event goes to the dead-letter queue

# ---------- Agent identities ----------
# Static bearer tokens for agents that can't do OAuth (Grok Bot). Claude/ChatGPT/Gemini use OAuth.
HUB_AGENT_TOKENS=grok:change-me
# Token the Mac daemon uses (also unlocks detailed /health)
HUB_DAEMON_TOKEN=change-me
# RATE_LIMIT_MCP_PER_MIN=120                  # per OAuth client
# RATE_LIMIT_LOGIN_PER_15MIN=10

# iMessage handles the daemon reads (phone or email, as they appear in Messages). Read-only.
IMESSAGE_HANDLES=instinct:+15551234567,stanley:+15557654321,boardy:+15550001111

# ---------- Approvals (pick one) ----------
# Every hand-off needs a reply like "Y K3FD" from YOU. Codes are single-use and expire.
# APPROVAL_CHANNEL=imessage                   # imessage | telegram | sms | none (inferred from what's set)
# APPROVAL_TTL_HOURS=12
# APPROVAL_MAX_INVALID=5                      # wrong codes per 15 min before approvals lock

# iMessage: the daemon texts this handle and accepts only replies sent from your own Mac/iPhone.
# Ideally a second number / Apple ID that is "the hub".
APPROVAL_IMESSAGE_HANDLE=
# Telegram: the hub's own bot, fully separate from agent threads
# APPROVAL_TELEGRAM_BOT_TOKEN=
# APPROVAL_TELEGRAM_CHAT_ID=
# APPROVAL_TELEGRAM_USER_ID=                  # your Telegram user id (defaults to the chat id)
# SMS: the hub's own Twilio number. Point its Messaging webhook at $HUB_PUBLIC_URL/twilio/sms
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# APPROVAL_USER_NUMBER=                       # your phone; replies from any other number are dropped

# ---------- Delivery (side channels only, never your own chat threads) ----------
SMTP_URL=                                     # smtps://you%40gmail.com:app-password@smtp.gmail.com:465
EMAIL_FROM=                                   # the address Instinct/Boardy know you by
INSTINCT_EMAIL=                               # Instinct's forwarding address
BOARDY_EMAIL=boardy@boardy.ai
# DELIVERY_MAX_ATTEMPTS=6                     # then the task goes to the dead-letter queue
# DELIVERY_BACKOFF_MS=60000
# ALLOW_THREAD_FALLBACK=false                 # true lets Instinct tasks fall back to your iMessage thread (not recommended)

# Read-only IMAP for bounces and Boardy's email replies (same mailbox as EMAIL_FROM)
# IMAP_URL=imaps://you%40gmail.com:app-password@imap.gmail.com:993
# IMAP_MAILBOX=INBOX

# Boardy "Ask Boardy" brief (boardy.ai/agents). Boardy can't search without LinkedIn.
# OWNER_FULL_NAME=Ved Thakar
# OWNER_BIO=Student and builder working on ...
# OWNER_OFFER=Help with ...
# OWNER_LOCATION=New York, open to remote
# OWNER_KEEP_PRIVATE=Don't mention my school by name
# OWNER_LINKS=LinkedIn=https://linkedin.com/in/you,X=https://x.com/you,GitHub=https://github.com/you

# Stanley over Telegram (user account; bots can't message bots). Run `npm run telegram:login` for the session.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
STANLEY_TELEGRAM_PEER=                        # Stan's Telegram @username

# Optional push nudge for Grok Bot (it can also just poll get_inbox). Signed with HMAC-SHA256 when the secret is set.
GROK_WEBHOOK_URL=
# GROK_WEBHOOK_SECRET=

# Regex that marks the start of the nightly debrief in the Instinct thread
# DEBRIEF_PATTERN=\b(debrief|end of (the )?day)\b
