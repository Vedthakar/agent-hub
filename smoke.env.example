# Copy to smoke.env (gitignored). Loaded on top of .env by `npm run smoke`.
# Every target here must be YOU. The script refuses targets that match an agent's address, handle or peer.

SMOKE_HUB_URL=https://hub.example.com        # defaults to HUB_PUBLIC_URL
SMOKE_EMAIL_TO=you@example.com               # defaults to EMAIL_FROM; never INSTINCT_EMAIL / Boardy
SMOKE_TELEGRAM_PEER=@your_test_bot           # a bot you own (create one with @BotFather); never STANLEY_TELEGRAM_PEER
# SMOKE_EXTRA_AGENT_PEERS=@other_agent_bot   # more Telegram peers the script must never message

# The approval check uses your configured approval channel (APPROVAL_IMESSAGE_HANDLE, APPROVAL_TELEGRAM_*,
# or TWILIO_* + APPROVAL_USER_NUMBER) from .env. The MCP check needs HUB_OWNER_PASSWORD for the consent screen.
